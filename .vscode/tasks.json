{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OC2: bootstrap macOS",
      "type": "shell",
      "command": "./scripts/macos-bootstrap.sh",
      "problemMatcher": []
    },
    {
      "label": "OC2: verify release",
      "type": "shell",
      "command": "./scripts/verify-release.sh",
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "OC2: Python unit tests",
      "type": "shell",
      "command": ".venv/bin/python -m unittest discover -s python-tests -v",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OC2: research tests",
      "type": "shell",
      "command": "PYTHONPATH=research-python/src .venv/bin/python -m unittest discover -s research-python/tests -v",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OC2: environment probe",
      "type": "shell",
      "command": ".venv/bin/python scripts/environment_probe.py --output artifacts/target-environment.json",
      "problemMatcher": []
    },
    {
      "label": "OC2: Docker integration",
      "type": "shell",
      "command": "OC2_API_TOKEN=${OC2_API_TOKEN:?set OC2_API_TOKEN} docker compose up --build -d --wait && .venv/bin/python scripts/integration_smoke.py",
      "problemMatcher": []
    },
    {
      "label": "OC2: Docker down",
      "type": "shell",
      "command": "docker compose down -v",
      "problemMatcher": []
    }
  ]
}
